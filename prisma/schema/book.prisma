model Book {
  id            String      @id @default(uuid())
  book_name     String
  publication   String
  created_by_id String?
  updated_by_id String?
  created_at    DateTime    @default(now())
  updated_at    DateTime?   @updatedAt
  created_by    User?       @relation("book_created_by", fields: [created_by_id], references: [id])
  updated_by    User?       @relation("book_updated_by", fields: [updated_by_id], references: [id])
  book_classes  BookClass[]

  @@unique([book_name, publication])
  @@index([book_name])
  @@map("books")
}
