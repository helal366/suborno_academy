model QuranicSpecialPeriod {
  id            String    @id @default(uuid())
  period_name   String    @unique
  start_time    String
  end_time      String
  created_by_id String?
  updated_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  created_by    User?     @relation("quranic_special_period_created_by", fields: [created_by_id], references: [id])
  updated_by    User?     @relation("quranic_special_period_updated_by", fields: [updated_by_id], references: [id])
  students      Student[] @relation("QuranicSpecialPeriodToStudent")

  @@map("quranic_special_periods")
}
