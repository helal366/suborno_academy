model QuranicSpecialPeriod {
  id          String @id @default(uuid())
  period_name String @unique
  start_time  String
  end_time    String

  students Student[]

  created_by_id String?
  created_by    User?   @relation("quranic_special_period_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("quranic_special_period_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("quranic_special_periods")
}

/**
 * *SPECIAL PERIODS: **
 * 1. NURANI_MORNING: 07:00 to 08:00
 * 2. NAZERA_MORNING: 06:00 to 08:00
 * 3. HIFZ_MORNING: 06:00 to 08:00
 * 4. NURANI_EVENING: 15:00 to 17:00
 * 5. NAZERA_EVENING: 15:00 to 17:00
 * 6. HIFZ_EVENING: 15:00 to 17:00
 * 7. NAZERA_NIGHT: AFTER MAGRIB to 20:00
 * 8. HIFZ_NIGHT: AFTER MAGRIB to 20:00
 * 9. NURANI_GIRLS: 09:45 to 10:30
 * 10. NAZERA_GIRLS: 08:00 to 10:30
 * 11. HIFZ_GIRLS: 08:00 to 10:30
 */
