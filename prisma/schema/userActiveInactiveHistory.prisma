model UserActiveInactiveHistory {
  id                String       @id @default(uuid())
  active_status     ActiveStatus
  activation_time   DateTime?
  inactivation_time DateTime?
  user_id           String
  created_by_id     String?
  updated_by_id     String?
  created_at        DateTime     @default(now())
  updated_at        DateTime?    @updatedAt
  created_by        User?        @relation("user_active_inactive_history_created_by", fields: [created_by_id], references: [id])
  updated_by        User?        @relation("user_active_inactive_history_updated_by", fields: [updated_by_id], references: [id])
  user              User         @relation("user_active_history", fields: [user_id], references: [id])

  @@map("active_inactive_histories")
}
