model Shift {
  id                  String         @id @default(uuid())
  name                String         @unique
  created_by_id       String?
  updated_by_id       String?
  created_at          DateTime       @default(now())
  updated_at          DateTime?      @updatedAt
  class_routine_shift ClassRoutine[]
  created_by          User?          @relation("shift_created_by", fields: [created_by_id], references: [id])
  updated_by          User?          @relation("shift_updated_by", fields: [updated_by_id], references: [id])

  @@map("shifts")
}
