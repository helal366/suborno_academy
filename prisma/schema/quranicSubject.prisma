model QuranicSubject {
  id              String          @id @default(uuid())
  subject_name    String          @unique
  quranic_section Quranic_Section
  created_by_id   String?
  updated_by_id   String?
  created_at      DateTime        @default(now())
  updated_at      DateTime?       @updatedAt
  created_by      User?           @relation("quranic_subject_created_by", fields: [created_by_id], references: [id])
  updated_by      User?           @relation("quranic_subject_updated_by", fields: [updated_by_id], references: [id])
  students        Student[]

  @@map("quranic_subjects")
}
