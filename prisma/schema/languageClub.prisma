model LanguageClub {
  id                           String                   @id @default(uuid())
  language_name                String
  extra_curriculum_activity_id String?
  extra_curriculum_activity    ExtraCurriculumActivity? @relation(fields: [extra_curriculum_activity_id], references: [id])
  students                     Student[]                @relation("LanguageClubToStudent")

  created_by_id                String?
  created_by                   User?                    @relation("language_club_created_by", fields: [created_by_id], references: [id])
  
  updated_by_id                String?
  updated_by                   User?                    @relation("language_club_updated_by", fields: [updated_by_id], references: [id])
  
  updated_at                   DateTime?                @updatedAt
  created_at                   DateTime                 @default(now())

  @@map("language_club")
}
