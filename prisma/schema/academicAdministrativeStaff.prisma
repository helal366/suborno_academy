model AcademicAdministrativeStaff {
  id                                String                            @id @default(uuid())
  full_name                         String
  current_position_id               String
  current_role_id                   String
  teaching_working_experience_year  Int?
  teaching_working_experience_month Int?
  alternative_contact_no            String[]
  user_id                           String                            @unique
  is_subject_teacher                Boolean                           @default(false)
  is_responsible_teacher            Boolean                           @default(false)
  created_by_id                     String?
  updated_by_id                     String?
  created_at                        DateTime                          @default(now())
  updated_at                        DateTime?                         @updatedAt
  academic_results                  AcademicResult?
  created_by                        User?                             @relation("academic_teacher_created_by", fields: [created_by_id], references: [id])
  current_position                  UserPosition                      @relation("academic_teacher_current_position", fields: [current_position_id], references: [id])
  current_role                      UserRole                          @relation("academic_teacher_current_role", fields: [current_role_id], references: [id])
  updated_by                        User?                             @relation("academic_teacher_updated_by", fields: [updated_by_id], references: [id])
  user_primary_data                 User                              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  my_classes                        ClassRoutine[]
  grade_teacher_class_name          Class?                            @relation("grade_teacher_class")
  group_teacher_class_name          Class?                            @relation("group_teacher_class")
  spouse_information                SpouseInformation?
  students_in_responsibility        StudentResponsibility[]
  subjects                          SubjectTeacher[]
  honourable_responsibilities       TeacherHonourableResponsibility[]
  joining_history                   JoiningHistory[]
  promoted_history                  PromotedHistory?
  positions                         UserPosition[]                    @relation("academic_teacher_positions")
  roles                             UserRole[]                        @relation("academic_teacher_roles")

  @@map("academic_teachers")
}
