model AcademicTeacher {
  id                  String   @id @default(uuid())
  full_name                   String
  role                        String
  position                    String
  current_position            String?
  positions                   String[]
  teaching_experience_year    Int?
  teaching_experience_month   Int?
  alternative_contact_no      String[]
  extra_curricular_activities String[]

  joining_history TeacherJoiningHistory[]

  user_id           String @unique
  user_primary_data User   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  spouse_information SpouseInformation?
  academic_results   AcademicResult?

  grade_teacher_class_name Class? @relation("grade_teacher_class")
  group_teacher_class_name Class? @relation("group_teacher_class")

  is_subject_teacher Boolean           @default(false)
  subjects           SubjectTeacher[]

  is_responsible_teacher     Boolean                  @default(false)
  students_in_responsibility StudentResponsibility[]

  honourable_responsibilities TeacherHonourableResponsibility[]

  my_classes ClassRoutine[]

  created_by_id String?
  created_by    User?   @relation("academic_teacher_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("academic_teacher_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  @@map("academic_teachers")
}
