model AuditLog {
  audit_id      String      @id @default(uuid())

  entity_id     String
  entity_name   String

  old_value     Json?
  new_value     Json?
  action        AuditAction

  changed_by_id String
  changed_by    User        @relation(fields: [changed_by_id], references: [id])
  
  created_at    DateTime    @default(now())

  @@map("audit_log")
}
