model AuditLog {
  audit_id      String      @id @default(uuid())
  entity_name   String
  entity_id     String
  action        AuditAction
  changed_by_id String
  old_value     Json?
  new_value     Json?
  created_at    DateTime    @default(now())
  changed_by    User        @relation(fields: [changed_by_id], references: [id])

  @@map("audit_log")
}
