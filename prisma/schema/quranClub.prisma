model QuranClub {
  id                           String                   @id @default(uuid())
  quran_name                   String
  extra_curriculum_activity_id String?
  created_by_id                String?
  updated_by_id                String?
  created_at                   DateTime                 @default(now())
  updated_at                   DateTime?                @updatedAt
  created_by                   User?                    @relation("quran_club_created_by", fields: [created_by_id], references: [id])
  extra_curriculum_activity    ExtraCurriculumActivity? @relation(fields: [extra_curriculum_activity_id], references: [id])
  updated_by                   User?                    @relation("quran_club_updated_by", fields: [updated_by_id], references: [id])
  students                     Student[]                @relation("QuranClubToStudent")

  @@map("quran_club")
}
