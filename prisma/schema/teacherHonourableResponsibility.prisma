model TeacherHonourableResponsibility {
  id                  String                       @id @default(uuid())
  responsibility_name String                       @unique
  teacher_id          String?
  created_by_id       String?
  updated_by_id       String?
  created_at          DateTime                     @default(now())
  updated_at          DateTime?                    @updatedAt
  created_by          User?                        @relation("teacher_honourable_responsibility_created_by", fields: [created_by_id], references: [id])
  teacher             AcademicAdministrativeStaff? @relation(fields: [teacher_id], references: [id], onDelete: Restrict)
  updated_by          User?                        @relation("teacher_honourable_responsibility_updated_by", fields: [updated_by_id], references: [id])

  @@map("teacher_honourableresponsibilities")
}
