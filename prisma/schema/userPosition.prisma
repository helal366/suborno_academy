model UserPosition {
  position_id   String @id @default(uuid())
  position_name String @unique

  role_name String
  role      UserRole  @relation(name: "role_position_relation", fields: [role_name], references: [role_name], onDelete: Restrict)
  user      User[] @relation("user_position_relation")

  created_by_id String?
  created_by    User?   @relation("user_position_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  
  updated_by_id String?
  updated_by    User?   @relation("user_position_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  @@map("user_positions")
}

