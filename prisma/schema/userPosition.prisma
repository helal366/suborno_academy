model UserPosition {
  id            String @id @default(uuid())
  position_name String @unique

  role_id String
  role    UserRole @relation(name: "role_position_relation", fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  user User[] @relation("user_position_relation")

  current_academic_teachers AcademicAdministrativeStaff[] @relation("academic_teacher_current_position")
  academic_teachers         AcademicAdministrativeStaff[] @relation("academic_teacher_positions")

  created_by_id String?
  created_by    User?   @relation("user_position_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updated_by_id String?
  updated_by    User?   @relation("user_position_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@map("user_positions")
}

